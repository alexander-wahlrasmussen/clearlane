# Copy to .env.local. Everything is optional — with no file the app runs on
# synthetic data with the deterministic mock Ask engine.

# Real declarations API (contracts/openapi.yaml). Leave unset for the in-memory mock.
# Requires a real AuthProvider — the stub refuses to start a production build against it.
#VITE_API_BASE=https://api.example.com/customs-insights/v1

# Ask engine: mock (default) | api (POST /ask/interpret on VITE_API_BASE) | anthropic-dev
#VITE_ASK_ENGINE=mock

# anthropic-dev ONLY: calls the Anthropic API straight from the browser with a personal key.
# Local demos only — the key is visible to the page. Refused in production builds.
#VITE_ANTHROPIC_API_KEY=sk-ant-...
#VITE_ANTHROPIC_MODEL=claude-opus-5
